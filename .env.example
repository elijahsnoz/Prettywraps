# Copy this file to .env.local and fill in the values.

# Get a key at https://console.anthropic.com
# Without it the site still works, but the concierge runs in a basic
# scripted mode instead of the full AI assistant.
ANTHROPIC_API_KEY=sk-ant-...

# Your live domain, no trailing slash.
# Drives the canonical tag, sitemap.xml, robots.txt and the WhatsApp/social
# share image. Set this before going live or search engines and link previews
# will point at the placeholder domain.
NEXT_PUBLIC_SITE_URL=https://prettywrapsng.com
